import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        if (!scanner.hasNextInt()) return;
        int T = scanner.nextInt();
        
        for (int t = 0; t < T; t++)
          {
            int N = scanner.nextInt();
            int K = scanner.nextInt();
            
            // Using 1-based indexing for stalls (size N + 1)
            int[] C = new int[N + 1];
            for (int i = 1; i <= N; i++)
          {
                C[i] = scanner.nextInt();
            }
            
            int minCost = Integer.MAX_VALUE;
            
            // Check all pairs of distinct stalls (i, j) with i < j
            for (int i = 1; i <= N; i++)  
                   {
                for (int j = i + 1; j <= N; j++)
              {
                    // 1. Stall i covers the left end (stall 1)
                    // 2. Stall j covers the right end (stall N)
                    // 3. There are no gaps between the two lights
                    if (i - K <= 1 && j + K >= N && j - i <= 2 * K + 1) 
                    {
                        int cost = C[i] + C[j];
                        if (cost < minCost) 
                      {
                            minCost = cost;
                        }
                    }
                }      
            
            if (minCost == Integer.MAX_VALUE)
          {
                System.out.println("-1");
            } else 
            {
                System.out.println(minCost);
            }
        }
        
        scanner.close();
    }
}
